server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # El navegador llama a /api-*; nginx reenvía a las APIs por la red interna.
    # URL_API_* se sustituyen al arrancar el contenedor (envsubst de la imagen nginx).
    location /api-seguridad/ {
        proxy_pass ${URL_API_SEGURIDAD}/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api-tickets/ {
        proxy_pass ${URL_API_TICKETS}/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA: react-router resuelve las rutas en el cliente
    location / {
        try_files $uri $uri/ /index.html;
    }
}
